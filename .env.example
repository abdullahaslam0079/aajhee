# Runtime env asset loaded by the app (see pubspec.yaml assets).
# Copy values into a local gitignored `.env` for editor tooling if you want,
# but do not put real secrets here — this file is committed.
# Host only (no /api). App paths already include /api/...
API_BASE_URL=https://api.aajhee.com
WEB_BASE_URL=https://aajhee.com
GOOGLE_MAPS_API_KEY=
# Optional Sentry (leave empty to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
